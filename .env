# =============================================================
# Шаблон .env — скопируй в .env и заполни своими значениями
# cp .env.example .env
# 
# НИКОГДА не коммить .env в git!
# =============================================================

# ─── База данных ─────────────────────────────────────
DB_NAME=bookinghub
DB_USER=postgres
DB_PASSWORD=postgres

# Для локальной разработки (docker compose dev):
#   DB_HOST=db
# Для подключения к внешнему серверу:
#   DB_HOST=94.156.102.42
DB_HOST=db
DB_PORT=5432

# ─── Django ─────────────────────────────────────
# Сгенерируй: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=your_secret_key_here

# True — локальная разработка, False — продакшн
DEBUG=True

# Через запятую: localhost,127.0.0.1,your_server_ip
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Суперпользователь ─────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=Admin123!